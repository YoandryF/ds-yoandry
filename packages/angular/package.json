{
  "name": "@ds-yoandry/angular",
  "version": "4.2.0",
  "description": "Design System for Angular 16+ with Signals support",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@angular/common": ">=20.0.0",
    "@angular/core": ">=20.0.0"
  },
  "dependencies": {
    "@ds-yoandry/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@angular/common": "^20.0.0",
    "@angular/core": "^20.0.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "files": ["dist", "README.md"],
  "keywords": ["design-system", "angular", "theme", "signals", "dark-mode"],
  "author": "Yoandry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoandryF/ds-yoandry.git",
    "directory": "packages/angular"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
