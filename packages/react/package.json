{
  "name": "@yoandryf/react",
  "version": "4.3.0",
  "description": "Design System for React and React Native with theme hook",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "@react-native-async-storage/async-storage": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": false
    }
  },
  "dependencies": {
    "@yoandryf/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-native": "^0.74.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "files": ["dist", "README.md"],
  "keywords": ["design-system", "react", "react-native", "theme", "dark-mode", "hook"],
  "author": "Yoandry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoandryF/ds-yoandry.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
